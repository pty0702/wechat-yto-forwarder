{
  "_说明": "适配格式示例，复制成local.json并按本机诊断核对，填写本账号在两边的完整群昵称。右键比例点必须单独确认。先用Ctrl+T准备检查；通过不代表实际发送或@已验收。微信只有空窗格时修改选择器无效。",
  "wx": {
    "window": {"name_regex": "微信|Weixin", "depth": 1},
    "process_name": "Weixin.exe",
    "group_title": {"type": "TextControl", "name": "{group}", "depth": 30},
    "messages": {"automation_id": "chat_message_list", "depth": 30},
    "message_item": {"class_name": "mmui::ChatTextItemView", "depth": 1},
    "parser": "wechat4",
    "context_points": [[0.25, 0.6], [0.75, 0.6]],
    "menu_depth": 8,
    "input": {"automation_id": "chat_input_field", "depth": 30},
    "self_names": ["请填写微信本账号在该群的完整昵称"],
    "id_attribute": "runtime_id",
    "send_keys": "{Enter}",
    "newline_keys": "{Shift}{Enter}",
    "mention_item": null,
    "mention_token": null,
    "mention_mode": null,
    "mention_allow_duplicate_names": false
  },
  "kf": {
    "window": {"name": "客户管家", "automation_id": "FrmMainView", "depth": 1},
    "process_name": "YtoChatApp.exe",
    "group_title": [
      {"type": "GroupControl", "name": "点击复制", "depth": 30},
      {"type": "TextControl", "name": "{group}", "depth": 1}
    ],
    "messages": {"automation_id": "imLayout", "depth": 30},
    "message_item": {"type": "GroupControl", "automation_id_regex": "[0-9]{15,22}"},
    "parser": "yto",
    "text_pattern_empty_leaf": false,
    "input": {"automation_id": "edit-content", "depth": 30},
    "self_names": ["请填写客户管家本账号的完整昵称"],
    "id_attribute": "automation_id",
    "send_keys": "{Enter}",
    "newline_keys": "{Ctrl}{Enter}"
  }
}
